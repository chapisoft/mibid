<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mibid</groupId>
        <artifactId>mibid-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>mibid-server</artifactId>
    <name>MIBID :: Server Application</name>
    <description>Central Spring Boot Application Server for MIBID</description>

    <dependencies>
        <dependency>
            <groupId>com.mibid</groupId>
            <artifactId>mibid-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mibid</groupId>
            <artifactId>mibid-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mibid</groupId>
            <artifactId>mibid-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mibid</groupId>
            <artifactId>mibid-s3</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mibid</groupId>
            <artifactId>mibid-outbox</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mibid</groupId>
            <artifactId>mibid-excel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mibid</groupId>
            <artifactId>mibid-iam-dms</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mibid</groupId>
            <artifactId>mibid-workflow-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mibid</groupId>
            <artifactId>mibid-sourcing-portal</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mibid</groupId>
            <artifactId>mibid-bidding-task</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mibid</groupId>
            <artifactId>mibid-logistics-analytics</artifactId>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
